# ===========================================
# CONFIGURACIÓN DE SEGURIDAD - NO COMMITEAR VALORES REALES
# ===========================================
# Copia este archivo a .env y completa con tus valores reales

# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_contraseña_segura
DB_NAME=organics

# JWT - USAR CLAVE MUY SEGURA (mínimo 64 caracteres aleatorios)
JWT_SECRET="GENERA_UNA_CLAVE_SEGURA_CON_AL_MENOS_64_CARACTERES"
JWT_EXPIRES_IN="24h"

# Servidor
PORT=5000
NODE_ENV=production

# Configuraciones
ENABLE_SCHEDULER=false
FRONTEND_URL=https://tu-dominio.com

# SMTP (para envío de correos)
SMTP_HOST=smtp.tu-servidor.com
SMTP_PORT=587
SMTP_USER=tu-correo@dominio.com
SMTP_PASS=tu-contraseña-smtp

# ===========================================
# RECOMENDACIONES DE SEGURIDAD:
# ===========================================
# 1. NUNCA commitear este archivo al repositorio
# 2. Usar npm audit regularmente
# 3. Cambiar todas las contraseñas periódicamente
# 4. Usar HTTPS en producción
# 5. Configurar firewall y cors correctamente
