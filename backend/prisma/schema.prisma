generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            String    @id @default(uuid())
  email         String    @unique @db.VarChar(255)
  username      String?   @unique @map("username") @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String?   @map("full_name") @db.VarChar(255)
  avatarUrl     String?   @map("avatar_url") @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  loginCount    Int       @default(0) @map("login_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  UserEmpresaID Int?      @map("user_empresa_id") // Empresa a la que pertenece el usuario

  userRoles         UserRoles[]
  createdEmpresas   Empresas[]        @relation("EmpresaCreador")
  createdPlanillas  Planilla[]        @relation("PlanillaCreador")
  approvedPlanillas Planilla[]        @relation("PlanillaAprobUser")
  planillaDetalles  PlanillaDetalle[]
  planillaOtros     PlanillaOtros[]
  rolePermissions   RolePermissions[] @relation("PermissionGrantedBy")
  userRolesAssigned UserRoles[]       @relation("RoleAssignedBy")
  empresaProductos  EmpresaPlanilla[]
  empresa           Empresas?         @relation("UsuarioEmpresa", fields: [UserEmpresaID], references: [EmpresaID])

  @@map("users")
}

model Roles {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermissions[]
  userRoles       UserRoles[]

  @@map("roles")
}

model Permissions {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  resource    String? @db.VarChar(50)
  action      String? @db.VarChar(50)
  description String? @db.Text

  rolePermissions RolePermissions[]

  @@map("permissions")
}

model UserRoles {
  userId     String    @map("user_id")
  roleId     Int       @map("role_id")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")

  user           Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Roles  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser Users? @relation("RoleAssignedBy", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermissions {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at")
  grantedBy    String?  @map("granted_by")

  role          Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser Users?      @relation("PermissionGrantedBy", fields: [grantedBy], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Empresas {
  EmpresaID                 Int       @id @default(autoincrement()) @map("EmpresaID")
  EmpresaTipo               String    @map("EmpresaTipo") @db.VarChar(100)
  EmpresaNombre             String    @map("EmpresaNombre") @db.VarChar(100)
  EmpresaDescripcion        String?   @map("EmpresaDescripcion") @db.VarChar(1000)
  EmpresaCreaFecha          DateTime? @map("EmpresaCreaFecha")
  EmpresaCreaUsuario        String?   @map("EmpresaCreaUsuario")
  EmpresaDocumento          String?   @map("EmpresaDocumento") @db.VarChar(1000)
  EmpresaNumeroDocumento    String?   @map("EmpresaNumeroDocumento") @db.VarChar(1000)
  EmpresaInicioPlantilla    DateTime? @map("EmpresaInicioPlantilla")
  EmpresaFinPlantilla       DateTime? @map("EmpresaFinPlantilla")
  EmpresaEnvioCorreo        Boolean   @default(true) @map("EmpresaEnvioCorreo")
  EmpresaCorreoNotificacion String?   @map("EmpresaCorreoNotificacion") @db.VarChar(100)
  EmpresaEstado             String    @default("A") @map("EmpresaEstado") @db.VarChar(1)
  EmpresaPlanilla           Boolean   @default(false) @map("EmpresaPlanilla")
  EmpresaLogo              String?   @map("EmpresaLogo") @db.VarChar(500)

  empresaProductos EmpresaPlanilla[]
  usuarios         Users[]           @relation("UsuarioEmpresa")

  creator   Users?     @relation("EmpresaCreador", fields: [EmpresaCreaUsuario], references: [id])
  planillas Planilla[]

  @@map("Empresas")
}

model Productos {
  ProductoID                  Int      @id @default(autoincrement()) @map("ProductoID")
  ProductoNombre              String   @map("ProductoNombre") @db.VarChar(200)
  ProductoCodigo              String?  @unique @map("ProductoCodigo") @db.VarChar(50)
  ProductoPrecio              Decimal  @default(0) @map("ProductoPrecio") @db.Decimal(12, 2)
  ProductoStock               Int      @default(0) @map("ProductoStock")
  ProductoActivo              Boolean  @default(true) @map("ProductoActivo")
  ProductoSoloContabilidad    Boolean  @default(false) @map("ProductoSoloContabilidad")

  detalles         PlanillaDetalle[]
  empresaProductos EmpresaPlanilla[]
  composiciones   ProductoComposicion[] @relation("ProductoPadre")
  componentes      ProductoComposicion[] @relation("ProductoComponente")

  @@map("Productos")
}

model ProductoComposicion {
  PCID          Int     @id @default(autoincrement()) @map("PCID")
  PCProducto    Int     @map("PCProducto")
  PCComponente  Int     @map("PCComponente")
  PCCantidad    Decimal @default(1) @map("PCCantidad") @db.Decimal(10, 4)

  producto   Productos @relation("ProductoPadre", fields: [PCProducto], references: [ProductoID], onDelete: Cascade)
  componente Productos @relation("ProductoComponente", fields: [PCComponente], references: [ProductoID], onDelete: Cascade)

  @@unique([PCProducto, PCComponente])
  @@map("ProductoComposicion")
}

model Planilla {
  PlanillaID                Int       @id @default(autoincrement()) @map("PlanillaID")
  PlanillaFecha             DateTime  @default(now()) @map("PlanillaFecha")
  PlanillaPuntoVenta        Int       @map("PlanillaPuntoVenta")
  PlanillaCreaUsuario       String    @map("PlanillaCreaUsuario")
  PlanillaCreaFecha         DateTime  @default(now()) @map("PlanillaCreaFecha")
  PlanillaEstado            String    @default("A") @map("PlanillaEstado") @db.VarChar(1)
  PlanillaVentaBruta        Int?      @map("PlanillaVentaBruta")
  PlanillaVentaEfectivo     Int?      @map("PlanillaVentaEfectivo")
  PlanillaVentaBancos       Int?      @map("PlanillaVentaBancos")
  PlanillaVentaNeta         Int?      @map("PlanillaVentaNeta")
  PlanillaVentaBOLD         Int?      @map("PlanillaVentaBOLD")
  PlanillaVentaNEQUI        Int?      @map("PlanillaVentaNEQUI")
  PlanillaVentaDAVIPLATA    Int?      @map("PlanillaVentaDAVIPLATA")
  PlanillaVentaQR           Int?      @map("PlanillaVentaQR")
  PlanillaAprobFecha        DateTime? @map("PlanillaAprobFecha")
  PlanillaAprobUser         String?   @map("PlanillaAprobUser")
  PlanillaFechaVencimiento  DateTime? @map("PlanillaFechaVencimiento")
  PlanillaEnvioNotificacion Boolean   @default(false) @map("PlanillaEnvioNotificacion")
  PlanillaFechaNotificacion DateTime? @map("PlanillaFechaNotificacion")

  puntoVenta Empresas          @relation(fields: [PlanillaPuntoVenta], references: [EmpresaID])
  creador    Users             @relation("PlanillaCreador", fields: [PlanillaCreaUsuario], references: [id])
  aprobUser  Users?            @relation("PlanillaAprobUser", fields: [PlanillaAprobUser], references: [id])
  detalles   PlanillaDetalle[]
  otros      PlanillaOtros[]

  @@map("Planilla")
}

model PlanillaDetalle {
  PDID           Int      @id @default(autoincrement()) @map("PDID")
  PlanillaID     Int      @map("PlanillaID")
  PDProducto     Int      @map("PDProducto")
  PDCantInicial  Float    @default(0) @map("PDCantInicial")
  PDCantCompra   Float    @default(0) @map("PDCantCompra")
  PDCantAjuste   Float    @default(0) @map("PDCantAjuste")
  PDCantVenta    Float    @default(0) @map("PDCantVenta")
  PDCantSubtotal Float    @default(0) @map("PDCantSubtotal")
  PDCantValor    Float    @default(0) @map("PDCantValor")
  PDCantFinal    Float    @default(0) @map("PDCantFinal")
  PDFechaReg     DateTime @default(now()) @map("PDFechaReg")
  PDUsuarioReg   String   @map("PDUsuarioReg")
  PDOrden        Int?     @map("PDOrden")

  planilla Planilla  @relation(fields: [PlanillaID], references: [PlanillaID], onDelete: Cascade)
  producto Productos @relation(fields: [PDProducto], references: [ProductoID])
  usuario  Users     @relation(fields: [PDUsuarioReg], references: [id])

  @@map("PlanillaDetalle")
}

model PlanillaOtros {
  POID           Int      @id @default(autoincrement()) @map("POID")
  PlanillaID     Int      @map("PlanillaID")
  PODescripcion  String   @map("PODescripcion") @db.Text
  POValor        Decimal  @default(0) @map("POValor") @db.Decimal(12, 2)
  POCategoria    String   @map("POCategoria") @db.VarChar(50)
  POUrlEvidencia String?  @map("POUrlEvidencia") @db.VarChar(500)
  POFechaReg     DateTime @default(now()) @map("POFechaReg")
  POUsuarioReg   String   @map("POUsuarioReg")

  planilla Planilla @relation(fields: [PlanillaID], references: [PlanillaID], onDelete: Cascade)
  usuario  Users    @relation(fields: [POUsuarioReg], references: [id])

  @@map("PlanillaOtros")
}

model EmpresaPlanilla {
  EPID            Int      @id @default(autoincrement()) @map("EPID")
  EmpresaID       Int      @map("EmpresaID")
  EPProducto      Int      @map("EPProducto")
  EPCreaUsuario   String   @map("EPCreaUsuario")
  EPValorProducto Decimal  @default(0) @map("EPValorProducto") @db.Decimal(12, 2)
  EPCreaFecha     DateTime @default(now()) @map("EPCreaFecha")
  EPActivo        Boolean  @default(true) @map("EPActivo")
  EPOrden         Int?     @map("EPOrden")

  empresa  Empresas  @relation(fields: [EmpresaID], references: [EmpresaID], onDelete: Cascade)
  producto Productos @relation(fields: [EPProducto], references: [ProductoID])
  creador  Users     @relation(fields: [EPCreaUsuario], references: [id])

  @@unique([EmpresaID, EPProducto])
  @@map("EmpresaPlanilla")
}

// Tablas no gestionadas por Prisma (usadas con SQL directo)
model ParametrosGenerales {
  PGID                  Int     @id @default(autoincrement()) @map("PGID")
  PGNombrePlataforma    String? @map("PGNombrePlataforma") @db.VarChar(100)
  PGRecuperacionPass    Boolean @default(true) @map("PGRecuperacionPass")
  PGImagenLogin         String? @map("PGImagenLogin") @db.VarChar(500)
  PGImagenPlataforma    String? @map("PGImagenPlataforma") @db.VarChar(500)
  PGImagenesCarrusel    String? @map("PGImagenesCarrusel") @db.Text

  @@map("ParametrosGenerales")
}

model ConfiguracionSMTP {
  ID            Int     @id @default(autoincrement()) @map("ID")
  SMTPHost     String? @map("smtphost") @db.VarChar(100)
  SMTPPort     Int?    @map("smtpport")
  SMTPUsuario  String? @map("smtpusuario") @db.VarChar(100)
  SMTPPassword String? @map("smtppassword") @db.VarChar(100)
  SMTPFromEmail String? @map("smtpfromemail") @db.VarChar(100)
  SMTPFromName  String? @map("smtpfromname") @db.VarChar(100)
  SMTPSecure    String? @map("smtpsecure") @db.VarChar(20)
  SMTPAuth      Boolean @default(true) @map("smtpauth")
  SMTPTimeout   Int?    @map("smtptimeout")

  @@map("configuracionsmtp")
}

model PlantillasCorreo {
  PlantillaID             Int     @id @default(autoincrement()) @map("PlantillaID")
  PlantillaNombre         String  @map("PlantillaNombre") @db.VarChar(100)
  PlantillaAsunto         String  @map("PlantillaAsunto") @db.VarChar(200)
  PlantillaCuerpo         String  @map("PlantillaCuerpo") @db.Text
  PlantillaVariables      String? @map("PlantillaVariables") @db.Text
  PlantillaTipo          String? @map("PlantillaTipo") @db.VarChar(50)
  PlantillaActivo         Boolean @default(true) @map("PlantillaActivo")
  PlantillaCreaFecha     DateTime @default(now()) @map("PlantillaCreaFecha")
  PlantillaActualizaFecha DateTime @default(now()) @map("PlantillaActualizaFecha")

  @@map("plantillascorreo")
}

model HistorialCorreos {
  CorreoID           Int      @id @default(autoincrement()) @map("CorreoID")
  CorreoDestinatario String   @map("CorreoDestinatario") @db.VarChar(255)
  CorreoAsunto       String   @map("CorreoAsunto") @db.VarChar(200)
  CorreoCuerpo       String   @map("CorreoCuerpo") @db.Text
  CorreoEstado       String   @map("CorreoEstado") @db.VarChar(20)
  CorreoFechaEnvio   DateTime @default(now()) @map("CorreoFechaEnvio")
  CorreoError        String?  @map("CorreoError") @db.Text
  CorreoEmpresaID    Int?     @map("CorreoEmpresaID")
  PlantillaID        Int?     @map("PlantillaID")

  @@map("HistorialCorreos")
}
